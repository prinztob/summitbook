<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/translucent70"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Stats Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Yearly Stats Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/dark_gray_transparent"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/current_year"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <!-- Yearly Stats Items -->
            <TextView
                android:id="@+id/activityYearly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_baseline_directions_run_24_green"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:text="@string/will_be_updated_soon"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/heightMeterYealy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_baseline_trending_up_24_green"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:text="@string/will_be_updated_soon"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/kilometersYearly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_baseline_compare_arrows_24_green"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:text="@string/will_be_updated_soon"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- Monthly Stats Column -->
        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/dark_gray_transparent"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/header_monthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/current_month"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <!-- Monthly Stats Items -->
            <TextView
                android:id="@+id/activityMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_baseline_directions_run_24_green"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:text="@string/will_be_updated_soon"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/heightMeterMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_baseline_trending_up_24_green"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:text="@string/will_be_updated_soon"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/kilometersMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:drawableStartCompat="@drawable/ic_baseline_compare_arrows_24_green"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:text="@string/will_be_updated_soon"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chart Image -->
    <ImageView
        android:id="@+id/chartImage"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/app_widget_preview_chart"
        app:srcCompat="@drawable/app_widget_preview_chart"
        android:contentDescription="@string/performance_chart"
        android:scaleType="fitCenter"
        android:visibility="visible" />

    <!-- Recent Summits Card -->
    <LinearLayout
        android:id="@+id/recentSummitsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/dark_gray_transparent"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="@string/recent_activities"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recentSummit1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/baseline_directions_run_24"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:text="@string/will_be_updated_soon"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
