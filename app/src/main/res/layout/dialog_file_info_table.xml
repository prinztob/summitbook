<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/file_info_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="0">

            <!-- Header Row -->
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/table_header_background"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/file_name"
                    android:textStyle="bold"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/exists"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/file_size"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/update"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/revert"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="4dp" />
            </TableRow>

            <!-- GPX Track Row -->
            <TableRow
                android:id="@+id/row_gpx_track"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <TextView
                    android:id="@+id/text_gpx_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:padding="4dp"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_gpx_exists"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/text_gpx_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/btn_update_gpx"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/baseline_refresh_24"
                    android:contentDescription="@string/update"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground" />

                <ImageButton
                    android:id="@+id/btn_revert_gpx"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/baseline_cancel_24"
                    android:contentDescription="@string/revert"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground" />
            </TableRow>

            <!-- Simplified GPX Track Row -->
            <TableRow
                android:id="@+id/row_gpx_simplified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:background="@color/table_row_alternate">

                <TextView
                    android:id="@+id/text_gpx_simplified_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:padding="4dp"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_gpx_simplified_exists"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/text_gpx_simplified_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/btn_update_gpx_simplified"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/baseline_refresh_24"
                    android:contentDescription="@string/update"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground" />

                <ImageButton
                    android:id="@+id/btn_revert_gpx_simplified"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/baseline_cancel_24"
                    android:contentDescription="@string/revert"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground" />
            </TableRow>

            <!-- Extensions YAML Row -->
            <TableRow
                android:id="@+id/row_extensions_yaml"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <TextView
                    android:id="@+id/text_yaml_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:padding="4dp"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_yaml_exists"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/text_yaml_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/btn_update_yaml"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/baseline_refresh_24"
                    android:contentDescription="@string/update"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground" />

                <ImageButton
                    android:id="@+id/btn_revert_yaml"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/baseline_cancel_24"
                    android:contentDescription="@string/revert"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground" />
            </TableRow>

            <!-- GPXPy JSON Row -->
            <TableRow
                android:id="@+id/row_gpxpy_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:background="@color/table_row_alternate">

                <TextView
                    android:id="@+id/text_gpxpy_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:padding="4dp"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_gpxpy_exists"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/text_gpxpy_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/btn_update_gpxpy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/baseline_refresh_24"
                    android:contentDescription="@string/update"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground" />

                <ImageButton
                    android:id="@+id/btn_revert_gpxpy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/baseline_cancel_24"
                    android:contentDescription="@string/revert"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground" />
            </TableRow>

        </TableLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_close_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@android:string/ok" />

</LinearLayout>